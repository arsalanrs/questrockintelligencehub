# ============================================================
# Central Hub — required environment variables
# Copy this to .env.local for local dev.
# Add ALL of these in Vercel → Project → Settings → Environment Variables.
# ============================================================

# Central Hub's own Supabase (= QR Dashboard's Supabase project)
# Used for Central Hub login + QR Dashboard SSO (same project)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_QR_DASHBOARD_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-qr-dashboard-anon-key

# ── Per-app service-role keys ────────────────────────────────────────────────
# Central Hub uses these to generate one-time magic links for each app.
# Each app keeps its OWN Supabase project — data stays separate.
# Get these from: each app's Supabase → Project Settings → API → service_role key

INCOME_BOT_SUPABASE_URL=https://YOUR_INCOME_BOT_PROJECT.supabase.co
INCOME_BOT_SERVICE_ROLE_KEY=your-income-bot-service-role-key

PIPELINE_SUPABASE_URL=https://YOUR_PIPELINE_PROJECT.supabase.co
PIPELINE_SERVICE_ROLE_KEY=your-pipeline-tracker-service-role-key

CREDIT_REPAIR_SUPABASE_URL=https://YOUR_CREDIT_REPAIR_PROJECT.supabase.co
CREDIT_REPAIR_SERVICE_ROLE_KEY=your-credit-repair-service-role-key

# ShapePhoneZap has no Supabase — it validates against Central Hub's Supabase (above).
# No extra keys needed for ShapePhoneZap.

# Optional
NEXT_PUBLIC_SITE_URL=https://your-centralhub-domain.vercel.app

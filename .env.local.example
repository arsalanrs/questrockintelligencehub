# ============================================================
# Central Hub — required environment variables
# ============================================================

# Central Hub login (= QR Dashboard Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_QR_DASHBOARD_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-qr-dashboard-anon-key

# Per-app SSO — URL + ANON key (not service role) for each tool
INCOME_BOT_SUPABASE_URL=https://YOUR_INCOME_BOT_PROJECT.supabase.co
INCOME_BOT_SUPABASE_ANON_KEY=your-income-bot-anon-key

PIPELINE_SUPABASE_URL=https://YOUR_PIPELINE_PROJECT.supabase.co
PIPELINE_SUPABASE_ANON_KEY=your-pipeline-anon-key

CREDIT_REPAIR_SUPABASE_URL=https://YOUR_CREDIT_REPAIR_PROJECT.supabase.co
CREDIT_REPAIR_SUPABASE_ANON_KEY=your-credit-repair-anon-key

# Password all QuestRock users were created with (optional — defaults to WelcomeToQuestRock1!)
SSO_BOOTSTRAP_PASSWORD=WelcomeToQuestRock1!

# Optional
NEXT_PUBLIC_SITE_URL=https://questrockintelligencehub.vercel.app
